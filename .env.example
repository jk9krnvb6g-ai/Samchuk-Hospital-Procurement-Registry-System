# ==========================================
# Samchuk Hospital Procurement Environment Variables
# ==========================================

# Database Connection (MySQL / MariaDB)
# Do not commit production passwords to git
PROCUREMENT_DB_HOST=YOUR_DATABASE_HOST
PROCUREMENT_DB_PORT=3306
PROCUREMENT_DB_USER=YOUR_DATABASE_USER
PROCUREMENT_DB_PASSWORD=YOUR_DB_PASSWORD_HERE
PROCUREMENT_DB_NAME=YOUR_DATABASE_NAME
PROCUREMENT_DB_CONNECTION_LIMIT=10

# Security & Authentication
# In production, set a strong, unpredictable 64+ character string
PROCUREMENT_JWT_SECRET=REPLACE_WITH_UNPREDICTABLE_64_CHARACTER_OR_LONGER_SECRET
PROCUREMENT_TOKEN_EXPIRY_HOURS=12

# Gateway Integration & Migration Controls
# When loaded by Central API Gateway, set GATEWAY_MODE=true
GATEWAY_MODE=true
# Prevent automated schema alterations in production
AUTO_MIGRATE=false

# Legacy plaintext passwords can still be verified; automated progressive migration is NOT implemented.
# Plan a reviewed, separate password migration before disabling legacy verification.

# Frontend Configuration
# URL where Central API Gateway serves the Procurement API
VITE_API_BASE_URL=https://YOUR_GATEWAY_HOST:3002/api/Procurement

# Standalone listener is disabled by default (Gateway should own port 3002).
PROCUREMENT_ALLOW_STANDALONE=false
# Only set true after DBA-approved migration review.
AUTO_MIGRATE=false
