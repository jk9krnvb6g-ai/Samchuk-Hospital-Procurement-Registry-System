# ==========================================
# Samchuk Hospital Procurement Environment Variables
# ==========================================

# Database Connection (MySQL / MariaDB)
# Do not commit production passwords to git
PROCUREMENT_DB_HOST=10.1.0.201
PROCUREMENT_DB_PORT=3306
PROCUREMENT_DB_USER=sa
PROCUREMENT_DB_PASSWORD=YOUR_DB_PASSWORD_HERE
PROCUREMENT_DB_NAME=procurement_db
PROCUREMENT_DB_CONNECTION_LIMIT=10

# Security & Authentication
# In production, set a strong, unpredictable 64+ character string
PROCUREMENT_JWT_SECRET=change_this_to_a_secure_random_secret_in_production
PROCUREMENT_TOKEN_EXPIRY_HOURS=12

# Gateway Integration & Migration Controls
# When loaded by Central API Gateway, set GATEWAY_MODE=true
GATEWAY_MODE=true
# Prevent automated schema alterations in production
AUTO_MIGRATE=false

# Password Migration Strategy
# Set to 'true' to automatically upgrade plaintext passwords to bcrypt hash on successful login
ENABLE_PROGRESSIVE_PASSWORD_HASHING=false

# Frontend Configuration
# URL where Central API Gateway serves the Procurement API
VITE_API_BASE_URL=https://10.2.0.13:3002/api/Procurement
